<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <schema id="org.gnome.shell.extensions.nautilus-zebra"
          path="/org/gnome/shell/extensions/nautilus-zebra/">

    <key name="enabled" type="b">
      <default>false</default>
      <summary>Enable zebra striping</summary>
      <description>Whether zebra striping is enabled in Nautilus list view</description>
    </key>

    <key name="stripe-color" type="s">
      <default>'rgba(128,128,128,0.05)'</default>
      <summary>Stripe color</summary>
      <description>RGBA color string for the zebra stripe</description>
    </key>

    <key name="opacity" type="i">
      <default>5</default>
      <summary>Stripe opacity percentage</summary>
      <description>Opacity of the zebra stripe (1-30)</description>
      <range min="1" max="30"/>
    </key>

    <key name="start-on-even" type="b">
      <default>true</default>
      <summary>Start striping on even rows</summary>
      <description>If true, even rows are striped; if false, odd rows are striped</description>
    </key>

  </schema>
</schemalist>
